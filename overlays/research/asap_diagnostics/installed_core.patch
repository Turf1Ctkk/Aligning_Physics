+    def _apply_recorded_velocities(self, curr_motion, curr_file, start, end, target_heading):
+        # Opt-in for the stock IsaacGym recorder: root velocities are in world
+        # coordinates. Retargeted task references retain their original behavior.
+        if not self.m_cfg.get('use_recorded_velocities', False):
+            return
+        if target_heading is not None:
+            raise ValueError('Recorded world velocities require target_heading=None')
+        expected_shapes = {
+            'dof_vel': (end - start, curr_motion.dof_pos.shape[-1]),
+            'root_lin_vel': (end - start, 3),
+            'root_ang_vel': (end - start, 3),
+        }
+        recorded = {}
+        for key, shape in expected_shapes.items():
+            if key not in curr_file:
+                raise ValueError('Missing recorded velocity field: ' + key)
+            value = to_torch(curr_file[key]).clone()[start:end].float()
+            if tuple(value.shape) != shape or not torch.isfinite(value).all():
+                raise ValueError('Invalid recorded velocity field: ' + key)
+            recorded[key] = value
+        curr_motion.dof_vels = recorded['dof_vel']
+        curr_motion.global_root_velocity = recorded['root_lin_vel']
+        curr_motion.global_root_angular_velocity = recorded['root_ang_vel']
+        # get_motion_state reads root velocities from these body tensors.
+        curr_motion.global_velocity = curr_motion.global_velocity.clone()
+        curr_motion.global_angular_velocity = curr_motion.global_angular_velocity.clone()
+        curr_motion.global_velocity[:, 0, :] = recorded['root_lin_vel']
+        curr_motion.global_angular_velocity[:, 0, :] = recorded['root_ang_vel']
+        if 'global_velocity_extend' in curr_motion:
+            curr_motion.global_velocity_extend = curr_motion.global_velocity_extend.clone()
+            curr_motion.global_angular_velocity_extend = curr_motion.global_angular_velocity_extend.clone()
+            curr_motion.global_velocity_extend[:, 0, :] = recorded['root_lin_vel']
+            curr_motion.global_angular_velocity_extend[:, 0, :] = recorded['root_ang_vel']
+
     def num_motions(self):
