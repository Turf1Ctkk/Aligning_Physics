+    def _infer_delta_for_current_action(self, obs_dict, nominal_actions):
+        # The post-step observation contains the previous nominal action.
+        # Replace just this feature; preserve the previous delta action and state.
+        delta_obs = obs_dict['closed_loop_actor_obs'].clone()
+        obs_config = self.env.config.obs
+        cursor = 0
+        found = False
+        for key in sorted(obs_config.obs_dict['closed_loop_actor_obs']):
+            width = int(obs_config.obs_dims[key])
+            if key == 'actions_sim2real_policy':
+                if width != nominal_actions.shape[-1]:
+                    raise ValueError('Nominal action observation dimension mismatch')
+                limit = self.env.config.robot.control.action_clip_value
+                action = torch.clip(nominal_actions, -limit, limit)
+                action = action * obs_config.obs_scales[key]
+                obs_limit = self.env.config.normalization.clip_observations
+                delta_obs[:, cursor:cursor + width] = torch.clip(action, -obs_limit, obs_limit)
+                found = True
+            cursor += width
+        if not found or cursor != delta_obs.shape[-1]:
+            raise ValueError('Unsupported delta observation layout')
+        return self.loaded_policy.eval_policy(delta_obs).detach()
+
